# Google API / Gemini / Gemma AI
GEMINI_API_KEY=your_gemini_api_key_here
# LLM Model Selection (Supported: gemini-3.6-flash, gemini-3.5-flash, gemini-3-flash, gemini-2.5-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-2.5-flash-lite, gemma-4-31b-it, gemma-4-26b-it)
LLM_MODEL=gemini-3.5-flash
# Fallback model variable (Backward compatibility)
GEMINI_MODEL=gemini-3.5-flash


# Supabase (PostgreSQL & Auth)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Upstash Redis
REDIS_URL=redis://localhost:6379
